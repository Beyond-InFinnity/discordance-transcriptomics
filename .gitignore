# R8: never commit data. Provenance lives in data/MANIFEST.yaml, not the files.
data/*
!data/MANIFEST.yaml
!data/.gitkeep

# Caches
.cache/
data/.cache/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Environments
.venv/
venv/
.env

# Results: keep manifests and text, never the heavy artifacts (§10)
results/**
!results/**/
!results/**/*.manifest.json
!results/**/*.md
!results/**/*.csv
!results/**/*.json

# Figures rebuilt from source
*.nii
*.nii.gz
*.gii
*.mgh
*.mgz

# OS / editor
.DS_Store
*.swp
.vscode/
.idea/

# Results are DERIVED DATA and are not tracked (R8's principle: provenance, not
# payload). Tracking them caused the project's worst failure: `rsync ./ host:`
# carried the laptop's committed copies onto a compute node and destroyed a
# completed regeneration, and wiping results/ for a clean run made the tree
# dirty, which the pipeline's own gate then refused to run on.
#
# Provenance does not require tracking. Every artifact carries a manifest with
# the git SHA, config hash, package versions and seed that produced it, and
# scripts/audit_provenance.py verifies they agree. Reproducibility lives in the
# code plus scripts/regenerate_all.sh, not in a committed copy of the output.
#
# The public deliverable is data/derived/annotation/, released separately.
results/

# Run logs are local scratch, never artifacts.
*.log
# ...as is the completion sentinel regenerate_all.sh drops.
regen.done
